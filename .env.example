# Copy to .env and fill in. Never commit the real .env.

# ── Telegram ───────────────────────────────────────────────
# 1. Open Telegram, message @BotFather, send /newbot, follow the prompts.
# 2. He replies with a token like 8123456789:AAH... — paste it here.
TELEGRAM_BOT_TOKEN=

# 3. Where alerts go. Easiest is one family group:
#      - create the group, add your bot to it, send /start in the group
#      - run: python get_chat_id.py
#      - paste the negative id it prints (keep the minus sign)
#    Or use personal chats instead: each of you messages @userinfobot for
#    your numeric id, list all three comma separated, and each of you must
#    send /start to YOUR bot once or Telegram will not deliver to you.
TELEGRAM_CHAT_IDS=

# Optional. Leave empty and anyone in the group can confirm a booking.
# Set personal user ids here to let the whole group see requests while only
# these people can approve them.
TELEGRAM_APPROVER_IDS=

# 5. Any long random string. Telegram sends it back on every webhook call
#    so nobody can POST fake Confirm/Reject events at your server.
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# ── Calendar feed ──────────────────────────────────────────
# The .ics URL is secret rather than password-protected, so make this long.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CALENDAR_TOKEN=

# ── Deployment ─────────────────────────────────────────────
# Public https origin once deployed, e.g. https://seriputra.up.railway.app
# Required for the Telegram webhook to register.
PUBLIC_BASE_URL=http://localhost:8000

# On Railway: mount a volume at /data and use /data/bookings.db
DATABASE_PATH=bookings.db

# ── Social links ───────────────────────────────────────────
INSTAGRAM_URL=https://instagram.com/seriputrahomestay
FACEBOOK_URL=https://facebook.com/seriputrahomestay
